    {
      "name": "research",
      "package": "@scholoom/research",
      "root": "packages/research",
      "sourceRoot": "src",
      "allows": [
        "@scholoom/protocol/core",
        "@scholoom/protocol/research",
        "@scholoom/protocol/harness",
