    {
      "name": "desktop",
      "package": "@scholoom/desktop",
      "root": "apps/desktop",
      "sourceRoot": "src",
      "allows": ["@scholoom/client", "@scholoom/editor", "@scholoom/kernel", "@scholoom/protocol"],
      "systemAdapters": [
        {
          "path": "src/main/**",
          "apis": ["electron", "child_process", "fs", "fs/promises", "fetch", "process.env"]
        },
        {
          "path": "src/preload/**",
          "apis": ["electron"]
        },
        {
          "path": "src/renderer/**",
          "apis": ["fetch"]
        }
      ],
      "provides": [],
      "consumes": []
    },
    {
      "name": "zotero-host",
      "package": "@scholoom/zotero-host",
      "root": "apps/zotero-host",
      "sourceRoot": "src",
      "allows": ["@scholoom/client", "@scholoom/protocol"],
      "systemAdapters": [
        {
          "path": "src/main/**",
          "apis": ["electron", "fs", "fs/promises", "process.env"]
        },
        {
          "path": "src/renderer/**",
          "apis": ["fetch"]
        }
      ],
      "provides": [],
      "consumes": []
    }
