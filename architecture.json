    {
      "name": "kernel",
      "package": "@scholoom/kernel",
      "root": "apps/kernel",
      "sourceRoot": "src",
      "allows": [
        "@scholoom/harness/node",
        "@scholoom/editor/node",
        "@scholoom/research/node",
        "@scholoom/broker",
        "@scholoom/client",
