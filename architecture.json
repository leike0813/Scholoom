          "path": "src/server.ts",
          "apis": ["http", "https", "net"]
        },
        {
          "path": "src/storage/project-container.ts",
          "apis": ["fs", "fs/promises"]
        }
      ],
      "provides": [],
      "consumes": ["models.status", "projects.list", "project.fileRevision", "harness.snapshot"]
