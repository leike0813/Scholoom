  "system": {
    "pure": [
      "path",
      "crypto",
      "url",
      "util",
      "events",
      "assert",
      "buffer",
      "stream",
      "string_decoder",
      "timers/promises"
    ],
    "specifiers": ["electron"],
    "globals": ["fetch", "process.env"]
  },
  "exceptions": []
