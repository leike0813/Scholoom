{
  "name": "scholoom",
  "version": "0.1.0",
  "private": true,
  "description": "Agent workbench and independent research kernel",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @scholoom/kernel... build",
    "typecheck": "pnpm build:shared && pnpm -r typecheck && tsc --noEmit -p tsconfig.tools.json",
    "lint": "biome check .",
    "check:architecture": "node scripts/check-architecture.ts",
    "generate:contracts": "node packages/protocol/scripts/contract-types.mjs --patch",
    "format": "biome format --write .",
    "check": "pnpm lint && pnpm check:architecture && pnpm typecheck && pnpm build && pnpm test:kernel && pnpm test:smoke && pnpm test:ui",
    "test:kernel": "playwright test --config playwright.kernel.config.ts",
    "setup:electron": "install-electron",
    "setup:ui": "playwright install chromium --only-shell",
    "test:ui": "pnpm setup:electron && playwright test --config playwright.ui.config.ts",
    "test:smoke": "pnpm setup:electron && playwright test",
    "dev:desktop": "pnpm build:shared && pnpm setup:electron && pnpm --filter @scholoom/desktop dev",
    "dev:browser": "pnpm build:shared && pnpm --filter @scholoom/desktop dev:browser",
    "dev:host": "pnpm setup:electron && pnpm --filter @scholoom/zotero-host dev",
    "kernel": "node apps/kernel/dist/cli.js",
    "package:dir": "pnpm build && pnpm --filter @scholoom/desktop package:dir && pnpm --filter @scholoom/zotero-host package:dir"
  },
  "devDependencies": {
    "ws": "8.22.0",
    "@types/ws": "8.18.2",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-builder-squirrel-windows": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  }
}
