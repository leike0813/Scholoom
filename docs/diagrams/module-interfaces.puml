@startuml
title 逻辑模块与接口依赖（初步设计）
skinparam defaultFontName Microsoft YaHei
skinparam shadowing false
skinparam componentStyle rectangle
top to bottom direction
component "工作台 / CLI\n共同协议入口" as Entry
component "Scholoom 对外 MCP 入口\nstdio / Streamable HTTP / Tasks" as ExternalMCP
component "文献管理\nLiterature / Materials（库）" as Literature
component "研究项目与研究资产\nWorkspaces / ResearchWork\nFiles / Decisions / Materials（项目）" as Work
component "内置 LangGraph harness\n通用会话 / 科研执行" as Harness
component "插件管理\n受管 MCP 能力" as PluginManager
component "科研业务与内容\nResearchContent / CapabilityExecutor" as Content
component "公共执行基础 / 模型接入\nManagedExecution / ModelCalls" as Runtime
component "Zotero 兼容层\nZoteroHost / 写回适配" as Host
Entry --> Literature : 查询 / 摄取 / 批注
Entry --> Work : 工作区 / 编辑 / 正式答复
Entry --> Harness : 会话 / 发送消息 / 停止
ExternalMCP --> Literature : 获授权查询
ExternalMCP --> Work : 获授权查询
ExternalMCP --> Harness : 提交 / 补充 / 请求撤回
Harness --> PluginManager : 获授权工具 / 资源
Harness --> Content : 解析定义 / 执行绑定
Harness --> Work : 任务 / 工件 / 等待决定
Harness --> Literature : 获授权材料工具
Harness --> Runtime : 受管程序 / 模型调用
Content --> Work : 经 context 使用领域工具
Content --> Literature : 经 context 读取材料
Host --> Literature : 映射身份 / 权威写回
note bottom of Host
  宿主生命周期由内核监督。
  插件对象留在宿主，DTO 仅跨进程传输。
end note
note bottom of Work
  库级与项目级科研工作共用契约，按 owner 落库。
  图中接口是职责集合，不预设新增同名包或类。
  通知使用有界订阅，不反向依赖调用者实现。
end note
@enduml
