{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@scholoom/client/host": ["../../packages/client/dist/host.d.ts"],
      "@scholoom/protocol/*": ["../../packages/protocol/dist/*"]
    },
    "noEmit": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": ["node", "vite/client"]
  },
  "include": ["src/**/*", "*.config.ts"]
}
